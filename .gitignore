# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.venv-omnidoc/
build/
dist/
*.so

# Local caches / model weights (redirected off the OS drive; never committed)
.cache/
*.pth
*.onnx
*.safetensors
*.bin

# Runtime / output
outputs/*
!outputs/.gitkeep
*.log

# Local/private data — real internal enterprise documents (see data/README.md).
# Only the README and the derived manifest are tracked.
data/*
!data/README.md
!data/manifest.json

# Experiments: the question, config, and conclusions ARE committed
# (README.md / config.yaml / results.json / observations.md); bulky
# per-run output is not.
experiments/**/outputs/
experiments/**/rendered/
experiments/**/*.png
experiments/**/*.jpg

# experiments/005_omnidocbench — the evaluator (an external dependency, not
# vendored — see experiments/005_omnidocbench/README.md), its own Python
# environment, the public dataset, and per-page prediction/debug output.
# What IS committed per backend: report.md, metrics.json, runtime.json,
# run_metadata.json, evaluator_config.yaml.
/.external/
experiments/005_omnidocbench/dataset/
experiments/005_omnidocbench/predictions/*
!experiments/005_omnidocbench/predictions/.gitkeep
experiments/005_omnidocbench/logs/*
!experiments/005_omnidocbench/logs/.gitkeep
experiments/005_omnidocbench/results/**/predictions/
experiments/005_omnidocbench/results/**/_doc_extraction_runs/
experiments/005_omnidocbench/results/**/*_result.json
# The evaluator's own environment fingerprint embeds this machine's
# hostname (`uname`) — excluded for that reason, not because its content
# is otherwise sensitive.
experiments/005_omnidocbench/results/**/*run_summary.json
experiments/005_omnidocbench/results/**/*runtime_environment.json
experiments/005_omnidocbench/kaggle/*.output.ipynb

# Environment / secrets
.env
.env.*
*.pem
*.key
credentials.json

# OS / editor
.vscode/
.idea/
Thumbs.db
.DS_Store

# Test / lint
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# research/ — prototypes and internal benchmarks (see research/hardcases/README.md).
# The corpus GENERATOR, its manifest and the generated PDFs are committed: they
# are synthetic, contain no enterprise data, and are the benchmark itself.
# Per-run working directories (rendered pages, crops, extraction output) are not.
research/**/_runs/
research/**/outputs/
# _dpi/ and _recovery/ hold regenerable working files (probe PDFs, rendered
# pages and crops) alongside one results.json that is the experiment's actual
# evidence. Exclude the contents, keep the numbers: the scripts that produce
# both are tracked, so the working files can be rebuilt and the findings cannot.
research/**/_dpi/*
!research/**/_dpi/results.json
research/**/_recovery/*
!research/**/_recovery/results.json
research/**/*.png
research/**/*.jpg
