# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.venv-omnidoc/
build/
dist/
*.so

# Local caches / model weights (redirected off the OS drive; never committed)
.cache/
*.pth
*.onnx
*.safetensors
*.bin

# Runtime / output
outputs/*
!outputs/.gitkeep
*.log

# Local/private data — real internal enterprise documents (see data/README.md).
# Only the README and the derived manifest are tracked.
data/*
!data/README.md
!data/manifest.json

# Experiments: the question, config, and conclusions ARE committed
# (README.md / config.yaml / results.json / observations.md); bulky
# per-run output is not.
experiments/**/outputs/
experiments/**/rendered/
experiments/**/*.png
experiments/**/*.jpg
# _runs/ holds per-document extraction output for an A/B (rendered pages,
# OCR tokens, assembled IR) -- 192 MB / 11,718 files for experiment 023
# alone. Same rule as research/**/_runs/: the measurement is committed as
# the experiment's *.json, the working files are regenerable from the
# tracked scripts plus the corpus, whose manifest carries a per-document
# sha256.
experiments/**/_runs/

# experiments/005_omnidocbench — the evaluator (an external dependency, not
# vendored — see experiments/005_omnidocbench/README.md), its own Python
# environment, the public dataset, and per-page prediction/debug output.
# What IS committed per backend: report.md, metrics.json, runtime.json,
# run_metadata.json, evaluator_config.yaml.
/.external/
experiments/005_omnidocbench/dataset/
experiments/005_omnidocbench/predictions/*
!experiments/005_omnidocbench/predictions/.gitkeep
experiments/005_omnidocbench/logs/*
!experiments/005_omnidocbench/logs/.gitkeep
experiments/005_omnidocbench/results/**/predictions/
experiments/005_omnidocbench/results/**/_doc_extraction_runs/
experiments/005_omnidocbench/results/**/*_result.json
# The evaluator's own environment fingerprint embeds this machine's
# hostname (`uname`) — excluded for that reason, not because its content
# is otherwise sensitive.
experiments/005_omnidocbench/results/**/*run_summary.json
experiments/005_omnidocbench/results/**/*runtime_environment.json
experiments/005_omnidocbench/kaggle/*.output.ipynb

# experiments/034a_omnidocbench_snapshot — external validation snapshot
# against the full public OmniDocBench (1651 pages, 1.4 GB of images +
# a 41 MB ground-truth annotation file). The raw dataset and per-page
# run output are not committed; the experiment's own scripts, JSON
# summaries, and reports are — see that experiment's README.md.
experiments/034a_omnidocbench_snapshot/dataset/
experiments/034a_omnidocbench_snapshot/results/**/predictions/
experiments/034a_omnidocbench_snapshot/results/**/_doc_extraction_runs/
# Same reason as the 005_omnidocbench rule above: these embed this
# machine's hostname via the evaluator's own `uname` fingerprint.
experiments/034a_omnidocbench_snapshot/results/**/*run_summary.json
experiments/034a_omnidocbench_snapshot/results/**/*runtime_environment.json

# Environment / secrets
.env
.env.*
*.pem
*.key
credentials.json

# OS / editor
.vscode/
.idea/
Thumbs.db
.DS_Store

# Test / lint
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# research/ — prototypes and internal benchmarks (see research/hardcases/README.md).
# The corpus GENERATOR, its manifest and the generated PDFs are committed: they
# are synthetic, contain no enterprise data, and are the benchmark itself.
# Per-run working directories (rendered pages, crops, extraction output) are not.
research/**/outputs/
# _runs/ holds per-document extraction output (rendered pages, intermediates)
# plus one results_*.json that is the measurement. Keep the measurement.
research/**/_runs/*
!research/**/_runs/results_*.json
# The production corpus is regenerable from its seeded generator and is 3.8 MB
# of binaries that will grow as the corpus does. The manifest carries a
# per-document sha256, so a regenerated corpus can be verified against the one
# a result was measured on -- which is what makes committing the numbers, and
# not the bytes, sufficient.
research/production_corpus/corpus/*
!research/production_corpus/corpus/manifest.json
# _dpi/ and _recovery/ hold regenerable working files (probe PDFs, rendered
# pages and crops) alongside one results.json that is the experiment's actual
# evidence. Exclude the contents, keep the numbers: the scripts that produce
# both are tracked, so the working files can be rebuilt and the findings cannot.
research/**/_dpi/*
!research/**/_dpi/results.json
research/**/_recovery/*
!research/**/_recovery/results.json
research/**/*.png
research/**/*.jpg

# Table-integrity probe working dir: only the JSON results are evidence.
research/experiments/_table_integrity/*.pdf
research/experiments/_scan_forensics/*.png
