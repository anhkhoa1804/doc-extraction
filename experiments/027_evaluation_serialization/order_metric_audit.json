{
 "question": "does order_ok measure page reading order, or table cell list order?",
 "method": "difference between the frozen serializer and a serializer identical except that table cells are iterated in (row, col) order",
 "totals_over_arms_with_n>=10": {
  "arms": 28,
  "order_ok_false_control": 107,
