# Normalize text to LF in the repository; Windows checkouts may still use CRLF.
* text=auto eol=lf

# Binary artifacts: never diff or line-ending-convert these.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff2 binary
*.ttf binary
*.pt binary
*.pth binary
*.onnx binary
*.safetensors binary
*.bin binary
*.docx binary
*.xlsx binary
*.pptx binary
*.parquet binary
